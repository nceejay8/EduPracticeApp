# Copy to .env.local and fill in. Never commit .env.local.
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# JavaScript bundle at build time. Anything here is readable by anyone who opens
# the deployed site — see the warning at the bottom.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is designed to be public and is safe to
# ship; access is controlled by Row Level Security, not by hiding this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Maestro AI (OpenRouter) ──────────────────────────────────────────────────
# https://openrouter.ai/keys
#
# ⚠️ This one is NOT safe to ship. Vite inlines it into the client bundle, so it
# is visible in the page source to every visitor and will be extracted and abused
# within minutes of deploying. For a public deployment either:
#   a) proxy the request through a serverless function that holds the key, or
#   b) issue a restricted key with a hard spend limit and a tight model allowlist.
# See the note in the README about wiring the proxy.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=
