# Copy to .env.local and fill in. Never commit .env.local.
#
#   cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# JavaScript bundle at build time. Anything here is readable by anyone who opens
# the deployed site — see the warning at the bottom.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is designed to be public and is safe to
# ship; access is controlled by Row Level Security, not by hiding this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Maestro AI ───────────────────────────────────────────────────────────────
# There is nothing to put here. Chat, grading and generation all go through the
# ai-proxy Edge Function (supabase/functions/ai-proxy), which holds the Gemini
# key as a server-side secret. A VITE_ variable would be inlined into the public
# bundle, which is exactly how the previous provider key leaked.
#
# The daily generator (scripts/generate-questions.mjs) also takes no key here:
# it needs SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and
# GENERATOR_SECRET from the environment — GitHub Actions secrets in CI, or
#   node --env-file=.env.local scripts/generate-questions.mjs
# locally. Never prefix those with VITE_.
